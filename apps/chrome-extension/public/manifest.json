{
  "manifest_version": 3,
  "name": "BwithU",
  "version": "0.1",
  "permissions": ["storage", "tabs", "identity", "sidePanel"],
  "optional_permissions": ["microphone"],
  "side_panel": {
    "default_path": "index.html"
  },
  "host_permissions": [
    "<all_urls>",
    "https://api.x.ai/*",
    "https://api.openai.com/*",
    "https://api.search.brave.com/*",
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.x.ai wss://api.x.ai https://api.openai.com wss://api.openai.com https://api.search.brave.com https://accounts.google.com https://www.googleapis.com https://bwithu-extension.vercel.app wss://bwithu-extension.vercel.app"
  },
  "action": {
    "default_title": "Toggle B",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["*.png", "*.svg", "*.glb", "*.json", "*.css", "*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
