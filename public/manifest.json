{
  "manifest_version": 3,
  "name": "BwithU",
  "version": "0.1",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle BwithU"
  },
  "web_accessible_resources": [
    {
      "resources": ["*.png", "*.svg", "*.css", "*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}